{
  "name": "whistle-client",
  "version": "1.5.2",
  "description": "Whistle Web Debugging Proxy",
  "main": "./build/main/index.js",
  "author": "avenwu <avwu@qq.com>",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "productName": "Whistle",
    "appId": "whistle.client",
    "asar": false,
    "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
    "copyright": "avenwu",
    "compression": "normal",
    "extends": null,
    "publish": [
      {
        "provider": "github",
        "owner": "avwo",
        "repo": "whistle-client",
        "releaseType": "draft"
      }
    ],
    "protocols": [
      {
        "name": "whistle",
        "schemes": [
          "whistle"
        ]
      }
    ],
    "files": [
      "build/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/dock.png",
      "target": {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    },
    "win": {
      "icon": "resources/whistle.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/whistle.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.3",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@monaco-editor/react": "4.8.0-rc.3",
    "antd": "^6.0.0",
    "byte-size": "^9.0.1",
    "electron-context-menu": "^3.6.1",
    "electron-log": "^5.4.3",
    "find-bar": "^0.1.3",
    "fs-extra": "^11.1.1",
    "mine-type": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "npminstall": "^7.9.0",
    "react-router-dom": "^7.11.0",
    "sudo-prompt": "^9.2.1",
    "whistle": "^2.9.106",
    "whistle.proxyauth": "^1.1.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@unocss/preset-icons": "^66.5.11",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^39.1.2",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.2.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.3.3",
    "unocss": "^66.5.11",
    "vite": "^5.0.12"
  }
}
